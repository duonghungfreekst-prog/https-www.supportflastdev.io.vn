# ==============================================================================
# Caddyfile - Reverse Proxy & Tự Động Cấp SSL HTTPS cho supportflastdev.io.vn
# Tự động yêu cầu chứng chỉ SSL miễn phí từ Let's Encrypt / ZeroSSL
# Tương thích hoàn toàn cả Linux VPS, Docker Container và Windows
# ==============================================================================

supportflastdev.io.vn, www.supportflastdev.io.vn {
    # Chuyển tiếp traffic tới Go Gateway Engine
    # Sử dụng biến môi trường UPSTREAM nếu có, mặc định là 127.0.0.1:8080
    reverse_proxy {$UPSTREAM:127.0.0.1:8080} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Bật nén Gzip và Zstandard để tối ưu tải tài nguyên Web 3D
    encode gzip zstd

    # Gắn bộ Security Headers bắt buộc chuẩn OWASP
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-XSS-Protection "1; mode=block"
        -Server
        -X-Powered-By
    }

    # Giới hạn kích thước upload gói ứng dụng (tối đa 500MB)
    request_body {
        max_size 500MB
    }

    # Nhật ký truy cập chuẩn hệ thống
    log {
        output stdout
        format console
    }
}
