<Window x:Class="SupportFlast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SupportFlast.dev.io.vn - Developer Dashboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left">
                    🚀 SupportFlast Developer Console
                </TextBlock>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Server Status:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtServerStatus" Text="Checking..." VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Margin="16,0,0,0" Content="Refresh" Click="BtnRefresh_Click" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Main Chat/Request Area -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,16">Gửi Yêu Cầu Hỗ Trợ AI</TextBlock>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="{Binding Color}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInput" Grid.Column="0" 
                                 materialDesign:HintAssist.Hint="Mô tả lỗi ứng dụng, xin tư vấn cấu hình CDN..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 VerticalAlignment="Center" KeyDown="TxtInput_KeyDown"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Gửi Yêu Cầu" Click="BtnSend_Click"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Subagents Status Area -->
            <materialDesign:Card Grid.Column="1" Margin="8,0,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,16">Hệ Thống AI Subagents</TextBlock>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListAgents">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding ColorBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding ColorBrush}" FontSize="14"/>
                                            <TextBlock Text="{Binding RoleDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="Gray"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <materialDesign:PackIcon Kind="Circle" Foreground="Lime" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" Online" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
