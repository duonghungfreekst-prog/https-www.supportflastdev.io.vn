# ==============================================================================
# SUPPORTFLAST PLATFORM - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Tên miền chính thức: supportflastdev.io.vn
# Kiến trúc: Unified Gateway (Go 8080) + 5 Subagents AI (Python 8000)
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Khi Go Engine khởi động, nếu chưa phát hiện file '.env', hệ thống sẽ TỰ ĐỘNG
#    sao chép từ file này thành '.env' và tự sinh ngẫu nhiên ADMIN_PASSWORD, JWT_SECRET.
# 2. Bạn có thể tự sao chép file này thành '.env' và điền các giá trị tùy chỉnh:
#      copy .env.example .env     (Windows CMD)
#      cp .env.example .env       (Linux / PowerShell)
# 3. TUYỆT ĐỐI KHÔNG commit file '.env' thật chứa mật khẩu vào Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG DỊCH VỤ & MẠNG (PORTS & NETWORK)
# ------------------------------------------------------------------------------
# PORT: Cổng HTTP chính của SupportFlast Unified Gateway.
# Phục vụ: Web 3D HUD UI, Cloud Storage (/storage), Dev Tools (/tools), REST API Gateway.
# Mặc định: 8080 (Cloud Hosting như Render, Railway, Fly.io có thể gán PORT tự động).
PORT=8080

# HOST: Địa chỉ IP giao diện mạng mà Go Engine lắng nghe.
# Mặc định: 0.0.0.0 (chấp nhận kết nối từ mọi interface mạng, Docker và VPS).
HOST=0.0.0.0

# AI_ENGINE_URL: Địa chỉ kết nối từ Go Gateway sang cụm 5 Subagents Python AI.
# Mặc định kết nối cục bộ nội bộ: http://127.0.0.1:8000
AI_ENGINE_URL=http://127.0.0.1:8000

# AI_HOST & AI_PORT: Địa chỉ IP và cổng dịch vụ của Python Subagents AI (FastAPI/Uvicorn).
AI_HOST=127.0.0.1
AI_PORT=8000

# ------------------------------------------------------------------------------
# 2. TÊN MIỀN & CHỨNG CHỈ BẢO MẬT SSL (DOMAIN & SSL)
# ------------------------------------------------------------------------------
# DOMAIN: Tên miền chính thức của hệ thống (dùng cho Let's Encrypt, Cloudflare WAF, CORS).
DOMAIN=supportflastdev.io.vn

# AUTO_HTTPS: Kích hoạt chế độ Standalone Auto-HTTPS tự động xin và gia hạn chứng chỉ Let's Encrypt (KHÔNG CẦN NGINX).
# Giá trị:
#   - false (Mặc định): Chạy sau Reverse Proxy (Cloudflare Tunnel, Nginx, Docker, Render, Railway) trên cổng PORT.
#   - true : Go Engine chạy độc lập (Standalone), tự lắng nghe port 80 (HTTP-01 ACME Challenge & 301 Redirect)
#            và port 443 (HTTPS TLS 1.2/1.3) bằng 'golang.org/x/crypto/acme/autocert'.
AUTO_HTTPS=false

# ACME_EMAIL: Email quản trị viên dùng để đăng ký tài khoản Let's Encrypt và nhận cảnh báo gia hạn chứng chỉ SSL tự động.
ACME_EMAIL=admin@supportflastdev.io.vn
SSL_EMAIL=admin@supportflastdev.io.vn

# HTTP_PORT: Cổng HTTP tiếp nhận ACME HTTP-01 challenge và tự động chuyển hướng 301 sang HTTPS (Mặc định: 80).
HTTP_PORT=80

# HTTPS_PORT: Cổng HTTPS chính cho chế độ Standalone Auto-HTTPS (Mặc định: 443).
HTTPS_PORT=443

# CERT_DIR: Thư mục lưu trữ bộ đệm chứng chỉ SSL Let's Encrypt (Mặc định: tự động đặt tại thư mục con 'certs' bên trong DATA_DIR).
# Tuân thủ Rule 1.4: Không lưu trên ổ C hệ thống.
CERT_DIR=f:\supportflast.dev\data\certs

# ALLOWED_ORIGINS: Danh sách nguồn gốc được phép gọi CORS (ngăn cách bằng dấu phẩy).
# TUYỆT ĐỐI KHÔNG dùng wildcard (*) để đảm bảo an toàn theo Rule 3.4.
ALLOWED_ORIGINS=https://supportflastdev.io.vn,http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 3. CHẾ ĐỘ MÔI TRƯỜNG (ENVIRONMENT MODE)
# ------------------------------------------------------------------------------
# ENV: Chế độ môi trường vận hành của toàn bộ hệ thống.
# Các giá trị hợp lệ:
#   - production : Bật toàn bộ lá chắn WAF, Rate Limiting nghiêm ngặt, ẩn stack trace lỗi.
#   - development: Chế độ phát triển cho lập trình viên, ghi log chi tiết, hỗ trợ gỡ lỗi.
#   - staging    : Chế độ kiểm thử tiền phát hành.
ENV=production

# ------------------------------------------------------------------------------
# 4. THƯ MỤC DỮ LIỆU & LƯU TRỮ (DATA & STORAGE PATHS)
# Tuân thủ Rule 1.4: Tuyệt đối không lưu dữ liệu dự án lên ổ C hệ thống.
# ------------------------------------------------------------------------------
# DATA_DIR: Thư mục chứa cơ sở dữ liệu SQLite, nhật ký WAL, khóa RSA Asymmetric, SIEM alerts.
# Windows: f:\supportflast.dev\data (Linux VPS: ./data hoặc /opt/supportflast/data)
DATA_DIR=f:\supportflast.dev\data

# STORAGE_DIR: Thư mục lưu trữ tệp tin tải lên, gói cài đặt (MSIX/EXE/APK/ZIP), CloudPool chunks.
# Windows: f:\supportflast.dev\storage (Linux VPS: ./storage hoặc /opt/supportflast/storage)
STORAGE_DIR=f:\supportflast.dev\storage

# UI_DIR: Thư mục chứa mã nguồn giao diện Web tĩnh (HTML/CSS/JS 3D HUD và các công cụ).
# Windows: f:\supportflast.dev\supportflast_ui (Linux VPS: ./supportflast_ui)
UI_DIR=f:\supportflast.dev\supportflast_ui

# STATIC_DIR: Thư mục tài nguyên tĩnh (nếu cần chỉ định riêng, mặc định trỏ về UI_DIR).
STATIC_DIR=f:\supportflast.dev\supportflast_ui

# JWT_KEYS_DIR: Thư mục lưu cặp khóa RSA Asymmetric (private_key.pem, public_key.pem).
# Mặc định: sẽ tự động đặt tại thư mục con 'keys' bên trong DATA_DIR.
JWT_KEYS_DIR=f:\supportflast.dev\data\keys

# ------------------------------------------------------------------------------
# 5. BẢO MẬT & XÁC THỰC JWT (SECURITY, JWT & ADMIN)
# ------------------------------------------------------------------------------
# JWT_SECRET: Khóa bí mật phục vụ mã hóa token nội bộ, ký HMAC dự phòng và sinh seed.
# Lưu ý: Khi Go Engine tự động tạo file '.env', hệ thống sẽ TỰ SINH chuỗi ngẫu nhiên 64 ký tự hex an toàn.
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_SUPPORTFLAST_2026

# ADMIN_USERNAME: Tên tài khoản Quản Trị Viên khởi tạo mặc định trong hệ thống SQLite.
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: Mật khẩu khởi tạo cho tài khoản Quản Trị Viên mặc định.
# Lưu ý: Khi Go Engine tự động tạo file '.env', hệ thống sẽ TỰ SINH mật khẩu ngẫu nhiên độ phức tạp cao (24 ký tự).
ADMIN_PASSWORD=Admin@2026!SupportFlast

# JWT_EXPIRY_MINUTES: Thời gian hiệu lực của token phiên đăng nhập (phút, mặc định: 1440 = 24 giờ).
JWT_EXPIRY_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. KHO LƯU TRỮ ĐÁM MÂY CLOUDPOOL & GOOGLE DRIVE (CLOUD INTEGRATION)
# ------------------------------------------------------------------------------
# OAUTH_CLIENT_ID: Mã Client ID Google Cloud OAuth 2.0 để kết nối Google Drive API.
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
OAUTH_CLIENT_ID=

# OAUTH_CLIENT_SECRET: Khóa bí mật Client Secret Google Cloud OAuth 2.0.
OAUTH_CLIENT_SECRET=

# OAUTH_REDIRECT_URL: Đường dẫn Callback xác thực OAuth 2.0 sau khi người dùng cấp quyền.
OAUTH_REDIRECT_URL=https://supportflastdev.io.vn/api/accounts/oauth/callback

# CLOUDPOOL_MASTER_KEY: Khóa mã hóa chủ quyền cho dữ liệu metadata và secret trong CloudPool Storage.
CLOUDPOOL_MASTER_KEY=cloudpool_secure_master_key_2026

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH CƠ SỞ DỮ LIỆU TIDB CLOUD (DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# DB_DRIVER: Trình điều khiển CSDL (sqlite / tidb / mysql). Mặc định: tidb
DB_DRIVER=tidb

# TIDB_HOST: Địa chỉ máy chủ TiDB Cloud Serverless Gateway.
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com

# TIDB_PORT: Cổng kết nối TiDB Cloud (Mặc định: 4000).
TIDB_PORT=4000

# TIDB_USER: Tên tài khoản người dùng TiDB Cloud.
TIDB_USER=vjwru2Q7m5oBvH2.root

# TIDB_PASSWORD: Mật khẩu kết nối TiDB Cloud.
TIDB_PASSWORD=

# TIDB_DATABASE: Tên cơ sở dữ liệu trên TiDB Cloud.
TIDB_DATABASE=supportflast

# TIDB_TLS: Bật kết nối bảo mật TLS/SSL cho TiDB Cloud (true / false).
TIDB_TLS=true
