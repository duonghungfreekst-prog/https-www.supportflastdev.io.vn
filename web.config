<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    =======================================================================================
    SupportFlast Unified Core Platform - IIS Web Configuration (web.config)
    Domain: supportflastdev.io.vn
    Môi trường: Windows Server 2016 / 2019 / 2022 / 2025 với IIS 10.0+
    
    Hỗ trợ 2 chế độ triển khai:
      1. [CHẾ ĐỘ MẶC ĐỊNH] IIS HttpPlatformHandler:
         - IIS trực tiếp quản lý vòng đời binary 'supportflast.exe'.
         - Tự cấp cổng động qua biến môi trường %HTTP_PLATFORM_PORT%.
         - Tự động khởi động lại tiến trình khi crash, giám sát tiến trình con.
         - Ghi stdout/stderr log vào thư mục logs/httpplatform-stdout.
      
      2. [CHẾ ĐỘ DỰ PHÒNG - FALLBACK] URL Rewrite / ARR Reverse Proxy:
         - Dùng khi SupportFlast chạy độc lập như một Windows Service (Port 8080)
           hoặc Standalone Binary.
         - IIS đóng vai trò làm Reverse Proxy chuyển tiếp yêu cầu sang http://127.0.0.1:8080.
         - Xem hướng dẫn chi tiết trong khối comment bên dưới.
    =======================================================================================
  -->

  <system.web>
    <!-- Cấu hình ASP.NET Pipeline cho phép upload file lớn đến 2GB (2097152 KB) -->
    <!-- executionTimeout="3600": Cho phép upload file lớn kéo dài tối đa 1 giờ -->
    <httpRuntime maxRequestLength="2097152" executionTimeout="3600" enableVersionHeader="false" requestValidationMode="2.0" />
    <compilation debug="false" targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <!-- ================================================================================= -->
    <!-- 1. CẤU HÌNH HANDLERS (HttpPlatformHandler)                                        -->
    <!-- ================================================================================= -->
    <handlers>
      <add name="HttpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <!-- ================================================================================= -->
    <!-- 2. CẤU HÌNH HTTP PLATFORM HANDLER (Chế độ chính)                                 -->
    <!-- ================================================================================= -->
    <!--
      Ghi chú:
      - processPath: Đường dẫn tới file nhị phân supportflast.exe.
                     Có thể sử dụng đường dẫn tương đối '.\supportflast.exe' nếu IIS Site
                     trỏ trực tiếp vào thư mục gốc dự án 'F:\supportflast.dev',
                     hoặc đường dẫn tuyệt đối 'F:\supportflast.dev\supportflast.exe'.
      - arguments: Tham số truyền vào binary (nếu cần).
      - startupTimeLimit: Thời gian tối đa (giây) chờ binary khởi động và lắng nghe port (120s).
      - startupRetryCount: Số lần thử lại nếu binary không phản hồi (3 lần).
      - stdoutLogEnabled: Bật ghi log đầu ra console để gỡ lỗi.
      - stdoutLogFile: Đường dẫn file log (.\logs\httpplatform-stdout).
      - processesPerApplication: Số lượng process chạy đồng thời cho mỗi worker process (1).
    -->
    <httpPlatform processPath=".\supportflast.exe"
                  arguments=""
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\httpplatform-stdout"
                  processesPerApplication="1">
      <environmentVariables>
        <!-- Cấp cổng động từ IIS cho SupportFlast Engine -->
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="DOMAIN" value="supportflastdev.io.vn" />
        <environmentVariable name="DATA_DIR" value=".\data" />
        <environmentVariable name="UI_DIR" value=".\supportflast_ui" />
        <environmentVariable name="GIN_MODE" value="release" />
      </environmentVariables>
    </httpPlatform>

    <!-- ================================================================================= -->
    <!-- 3. CẤU HÌNH WEBSOCKET                                                             -->
    <!-- ================================================================================= -->
    <!-- Yêu cầu: Đã bật tính năng 'WebSocket Protocol' trong Windows Features / IIS Roles -->
    <webSocket enabled="true" receiveBufferLimit="4194304" pingInterval="00:00:30" />

    <!-- ================================================================================= -->
    <!-- 4. CẤU HÌNH BẢO MẬT & REQUEST FILTERING (Upload file 2GB)                        -->
    <!-- ================================================================================= -->
    <security>
      <requestFiltering>
        <!-- maxAllowedContentLength: 2147483648 bytes = đúng 2.0 GiB (2 * 1024 * 1024 * 1024) -->
        <!-- maxUrl="4096", maxQueryString="4096": Giới hạn độ dài URL chống DoS/Buffer Overflow -->
        <requestLimits maxAllowedContentLength="2147483648" maxUrl="4096" maxQueryString="4096" />
        <fileExtensions allowUnlisted="true" />
        <verbs allowUnlisted="true" />
      </requestFiltering>
    </security>

    <!-- ================================================================================= -->
    <!-- 5. SECURITY HEADERS & TIÊU CHUẨN AN NINH MẠNG                                    -->
    <!-- ================================================================================= -->
    <httpProtocol>
      <customHeaders>
        <!-- Gỡ bỏ các header tiết lộ thông tin công nghệ máy chủ (Information Disclosure) -->
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <remove name="X-AspNet-Version" />

        <!-- Security Headers bắt buộc theo quy chuẩn an ninh -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ================================================================================= -->
    <!-- 6. ĐỊNH DẠNG TÀI NGUYÊN TĨNH (MIME Types)                                         -->
    <!-- ================================================================================= -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <remove fileExtension=".msix" />
      <mimeMap fileExtension=".msix" mimeType="application/msix" />
      <remove fileExtension=".exe" />
      <mimeMap fileExtension=".exe" mimeType="application/octet-stream" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- ================================================================================= -->
    <!-- 7. CHẾ ĐỘ FALLBACK: IIS URL REWRITE / ARR REVERSE PROXY                           -->
    <!-- ================================================================================= -->
    <!--
      HƯỚNG DẪN KÍCH HOẠT CHẾ ĐỘ REVERSE PROXY (Standalone Windows Service trên Port 8080):
      1. Cài đặt các module IIS:
         - URL Rewrite 2.1 (https://www.iis.net/downloads/microsoft/url-rewrite)
         - Application Request Routing - ARR 3.0 (https://www.iis.net/downloads/microsoft/application-request-routing)
      2. Trong IIS Manager -> Mở 'Application Request Routing Server Proxy' -> Server Proxy Settings -> Tích 'Enable proxy'.
      3. Bỏ comment khối <rewrite> bên dưới và comment hoặc xóa khối <httpPlatform> & <handlers> ở trên.
    -->
    <!--
    <rewrite>
      <rules>
        <clear />
        <rule name="ReverseProxyToSupportFlastStandalone" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_SCHEMA" value="https" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    -->

  </system.webServer>
</configuration>
