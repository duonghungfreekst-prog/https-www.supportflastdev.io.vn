# ==============================================================================
# SUPPORTFLAST.DEV - UNIVERSAL APACHE & CPANEL CONFIGURATION (.htaccess)
# Tương thích: Apache 2.4+, LiteSpeed, cPanel, DirectAdmin, Plesk
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẬT REWRITE ENGINE & BUỘC TRUY CẬP HTTPS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Tự động chuyển hướng từ HTTP sang HTTPS (Full Encryption)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH REVERSE PROXY TỚI SUPPORTFLAST UNIFIED ENGINE (CỔNG 8080)
# (Áp dụng nếu máy chủ Shared Hosting/cPanel có kích hoạt mod_proxy)
# ------------------------------------------------------------------------------
<IfModule mod_proxy.c>
    # Forward toàn bộ API calls, WebSocket và Storage sang backend Go Engine
    # Lưu ý: Bỏ comment các dòng dưới nếu cPanel cho phép mod_proxy
    # RewriteRule ^api/(.*)$ http://127.0.0.1:8080/api/$1 [P,L]
    # RewriteRule ^storage/(.*)$ http://127.0.0.1:8080/storage/$1 [P,L]
    # RewriteRule ^tools/(.*)$ http://127.0.0.1:8080/tools/$1 [P,L]
    # RewriteRule ^ws/(.*)$ ws://127.0.0.1:8080/ws/$1 [P,L]
    # ProxyPassReverse / http://127.0.0.1:8080/
</IfModule>

# ------------------------------------------------------------------------------
# 3. ĐIỀU HƯỚNG TÀI NGUYÊN TĨNH & SPA ROUTING (WEB 3D HUD FRONTEND)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    # Nếu file hoặc thư mục vật lý tồn tại, phục vụ trực tiếp
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Điều hướng công cụ tools
    RewriteRule ^tools$ tools.html [L]
    RewriteRule ^tools/$ tools.html [L]

    # Mặc định SPA fallback về index.html (cho Web 3D HUD và các trang nội bộ)
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. THIẾT LẬP BẢO MẬT & SECURITY HEADERS BẮT BUỘC
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Chống MIME-sniffing
    Header set X-Content-Type-Options "nosniff"

    # Chống tấn công Clickjacking
    Header set X-Frame-Options "DENY"

    # Chống tấn công XSS dạng phản xạ
    Header set X-XSS-Protection "1; mode=block"

    # Chính sách Referrer nghiêm ngặt
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Buộc dùng HTTPS trong 1 năm (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy (Hỗ trợ Three.js 3D WebGL và Web Workers)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' ws: wss: https:;"

    # Ẩn định danh Web Server
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ------------------------------------------------------------------------------
# 5. BẢO VỆ TỆP TIN NHẠY CẢM KHỎI BỊ TRUY CẬP TRỰC TIẾP
# ------------------------------------------------------------------------------
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|db|sqlite|sqlite3|toml|yaml|yml|mod|sum))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Chặn xem thư mục cấm
Options -Indexes

# ------------------------------------------------------------------------------
# 6. TỐI ƯU HÓA TỐC ĐỘ NÉN GZIP / DEFLATE
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 7. CACHE BROWSER ĐỊNH KỲ CHO STATIC ASSETS
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
